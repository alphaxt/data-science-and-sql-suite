# IBM Watson Natural Language Understanding credentials.
# Copy this file to `.env` and fill in real values to use the live
# Watson API. If left as placeholders (or absent), the app runs with a
# keyword-based mock so it still works without an API key.

WATSON_NLU_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com/instances/YOUR_INSTANCE_ID
WATSON_NLU_APIKEY=YOUR_API_KEY

# Flask runtime settings (optional)
FLASK_DEBUG=true
PORT=5000
